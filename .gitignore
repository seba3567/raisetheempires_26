# Rama "assets": solo recursos del juego, sin backend ni tooling.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
/htmlcov/

# Logs y volcados
*.log
/log.txt.*
/server.out.log
/server.err.log
/flask.out.log
/flask.err.log
/_*.log
/_*.err
/_tools/
/_*.py

# Cache y artefactos de build
/dist*/
/build/
/*.spec
/instance
/cache
/.idea

# Copias de respaldo de assets, guardadas por si un swf sale mal.
/assets/*.bak
/assets/*.bak[0-9]*
