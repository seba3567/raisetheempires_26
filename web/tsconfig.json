{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		/*
		 * SvelteKit 3 renamed $lib to #lib and declares it through the
		 * package.json "imports" field, but svelte-check does not read that, so
		 * the same mapping has to be mirrored here for types to resolve.
		 */
		"paths": {
			"#lib": ["./src/lib/index.js"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}