# ---------------------------------------------------------------------------
# Copy to web/.env and fill it in. The service reads this file itself, so the
# variables do not have to be exported for `bun run build` or `bun ./build`.
# ---------------------------------------------------------------------------

# The port the public front binds.
#
# It has to be the port of PUBLIC_ORIGIN. The Bun adapter rewrites every
# incoming request onto the origin baked into the build, and SvelteKit
# refuses any form POST whose `Origin` header is somewhere else -- so a port
# that disagrees with the origin does not fail loudly, it fails as a 403
# "Cross-site POST form submissions are forbidden" on the login.
PORT=8080

# The interface to bind. 0.0.0.0 exposes the site; 127.0.0.1 keeps it local.
HOST=0.0.0.0

# The origin the browser uses. This is what gets baked into the build, so it
# has to be the address the player actually types.
#
# Leave it empty to use `http://localhost:<PORT>`. Set it when the site lives
# somewhere else -- a domain, or a machine that is not localhost.
PUBLIC_ORIGIN=http://localhost:8080

# Extra origins allowed to POST a form, comma separated. Only needed when the
# site is reachable under more than one name (a domain and an IP, say). The
# loopback aliases of a loopback origin are trusted automatically.
PUBLIC_TRUSTED_ORIGINS=

# The AMF0 gateway. Keep it on loopback: this service is its only front door.
GATEWAY_ORIGIN=http://127.0.0.1:5005

# Longest AMF0 request buffered before it is refused. Matches Flask's
# MAX_FORM_MEMORY_SIZE.
GATEWAY_MAX_BODY=5MB

# Account/friends/progress store. PostgreSQL 18, the same server the gateway
# uses for the saves, so the whole project has one store.
# La base que usan LAS DOS mitades del proyecto, con este nombre en las dos.
# El gateway la leía antes como SAVE_STORE_PATH: ese nombre sigue funcionando
# como alias, pero si pones uno de cada par las dos mitades quedan apuntando
# a bases distintas.
RTE_DB_URL=postgres://postgres:42kSM0ud2nRLlTZv6YVsXgPcbxwAx9Qe!7a@127.0.0.1:5432/raisetheempires

# Bare database name, for the CREATE DATABASE that runs before connecting.
RTE_DB_NAME=raisetheempires

# Signs the session cookie. Required. Generate one with:
#   bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
SESSION_SECRET=

SESSION_COOKIE=rte_session
SESSION_MAX_AGE=315360000

# ---------------------------------------------------------------- adapter-bun
# The official @sveltejs/adapter-bun caps request bodies at 512K by default.
# The AMF0 gateway posts binary payloads well past that, and Flask is
# configured for 5 MB (MAX_FORM_MEMORY_SIZE), so the proxy has to accept at
# least as much or large requests get a 413 before Flask ever sees them.
BODY_SIZE_LIMIT=6MB
