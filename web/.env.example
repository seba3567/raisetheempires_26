# Public port for this service.
PORT=8080
HOST=0.0.0.0

# The AMF0 gateway. Keep it on loopback: this service is its only front door.
GATEWAY_ORIGIN=http://127.0.0.1:5005

# Account/friends/progress store. One file, no external service.
DATABASE_FILE=instance/web.db

# Signs the session cookie. Required. Generate one with:
#   bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
SESSION_SECRET=

SESSION_COOKIE=rte_session
SESSION_MAX_AGE=315360000

# ---------------------------------------------------------------- adapter-bun
# The official @sveltejs/adapter-bun caps request bodies at 512K by default.
# The AMF0 gateway posts binary payloads well past that, and Flask is
# configured for 5 MB (MAX_FORM_MEMORY_SIZE), so the proxy has to accept at
# least as much or large requests get a 413 before Flask ever sees them.
BODY_SIZE_LIMIT=6MB